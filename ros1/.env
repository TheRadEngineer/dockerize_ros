# ros1 settings. Read by docker compose and by the scripts in this folder.

# Your host user. The container user gets the same name, UID and GID so files
# in the shared folders keep the right owner.
ROS1_USER=kd
ROS1_UID=1000
ROS1_GID=1000

# Image the Dockerfile builds on: stock Ubuntu 20.04 (you install ROS Noetic
# yourself), or a company dev image (must be Ubuntu/Debian based).
ROS1_BASE_IMAGE=ubuntu:20.04

# Every commit adds an image layer (Docker's hard limit is ~125).
# ros1:latest is flattened on stop once it has more layers than this.
ROS1_SQUASH_THRESHOLD=90

# Compose files to use, separated by ":".
#   compose.nvidia.yaml  NVIDIA GPU    (drop it to run without the GPU)
#   compose.mongo.yaml   MongoDB 6.0   (drop it if you don't need the database)
COMPOSE_FILE=compose.yaml:compose.nvidia.yaml:compose.mongo.yaml
