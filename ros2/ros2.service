[Unit]
Description=ROS2 development container (ros2)
Documentation=file:///opt/ros-containers/README.md
Requires=docker.service
After=docker.service
# Give up after 3 failed starts in 2 minutes instead of looping.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=/opt/ros-containers/ros2

# Always start from a fresh container made from ros2:latest.
ExecStartPre=/opt/ros-containers/ros2/commit.sh prestart
ExecStart=/usr/bin/docker compose up --no-build --pull never --no-log-prefix
ExecStartPost=/opt/ros-containers/ros2/commit.sh wait

# reload = checkpoint commit while running; stop/restart/shutdown = commit on stop.
ExecReload=/opt/ros-containers/ros2/commit.sh checkpoint
ExecStop=/opt/ros-containers/ros2/commit.sh stop

# `docker compose up` may exit via SIGINT/SIGTERM when the container stops.
SuccessExitStatus=130 143
Restart=on-failure
RestartSec=5
# Also the time limit for `reload` (systemd has no separate one), and a save
# of a large image can take several minutes.
TimeoutStartSec=900
# Committing (and occasionally squashing) a large image takes time.
TimeoutStopSec=900

[Install]
WantedBy=multi-user.target
